#!/usr/bin/env bash
#
# A mock implementation of Apple's Time Machine utility (tmutil).
#
# Uses the ASIMOV_TEST_EXCLUSIONS environment variable, which should point
# to a temporary file that acts as the exclusion database.

set -euo pipefail

if [[ -z "${ASIMOV_TEST_EXCLUSIONS:-}" ]]; then
  echo "Error: ASIMOV_TEST_EXCLUSIONS is not set." >&2
  exit 1
fi

subcommand="${1:-}"
shift || true

# Log every call when ASIMOV_TEST_TMUTIL_LOG is set, one line per call with each
# argument shell-quoted, so tests can tell which paths reached which subcommand.
if [[ -n "${ASIMOV_TEST_TMUTIL_LOG:-}" ]]; then
  {
    printf '%s' "$subcommand"
    [[ $# -gt 0 ]] && printf ' %q' "$@"
    printf '\n'
  } >> "$ASIMOV_TEST_TMUTIL_LOG"
fi

case "$subcommand" in
  isexcluded)
    # Simulate tmutil being unable to read exclusions at all — what a Mac
    # without Full Disk Access looks like to `asimov doctor`.
    if [[ -n "${ASIMOV_TEST_TMUTIL_ISEXCLUDED_FAIL:-}" ]]; then
      echo "tmutil: unable to read exclusion setting" >&2
      exit 1
    fi
    # Simulate tmutil printing something other than a status line on stdout.
    if [[ -n "${ASIMOV_TEST_TMUTIL_ISEXCLUDED_NOISE:-}" ]]; then
      echo "tmutil: note: this is not a status line"
    fi
    # Like real tmutil, takes several paths and prints one "[Status]  path" line
    # per path, in order, padded with spaces and with symlinks resolved. A path
    # that doesn't exist is [UNKNOWN], and so is one listed in
    # ASIMOV_TEST_TMUTIL_UNKNOWN_PATHS — what a scheduled run sees inside a
    # privacy-protected folder such as ~/Documents.
    for path in "$@"; do
      if [[ ! -e "$path" ]] || { [[ -n "${ASIMOV_TEST_TMUTIL_UNKNOWN_PATHS:-}" ]] \
          && grep -Fxq "$path" "$ASIMOV_TEST_TMUTIL_UNKNOWN_PATHS" 2>/dev/null; }; then
        printf '%-12s%s\n' '[UNKNOWN]' "$path"
        continue
      fi
      shown="$path"
      if [[ -d "$path" ]]; then
        shown="$(cd "$path" && pwd -P)"
      fi
      # A path is excluded if it — or any ancestor directory — is in the exclusion
      # database. Real tmutil reports descendants of a path-based exclusion as
      # excluded too (TM exclusions are recursive), so a manually excluded parent
      # like ~/.nvm covers ~/.nvm/.../node_modules.
      excluded=false
      probe="$path"
      while :; do
        if grep -Fxq "$probe" "$ASIMOV_TEST_EXCLUSIONS" 2>/dev/null; then
          excluded=true
          break
        fi
        parent="$(dirname "$probe")"
        [[ "$parent" == "$probe" ]] && break
        probe="$parent"
      done
      if [[ "$excluded" == true ]]; then
        printf '%-12s%s\n' '[Excluded]' "$shown"
      else
        printf '%-12s%s\n' '[Included]' "$shown"
      fi
    done
    ;;
  addexclusion)
    # Supports multiple paths: tmutil addexclusion path1 path2 ...
    for path in "$@"; do
      # Simulate failure for paths listed in ASIMOV_TEST_TMUTIL_FAIL_PATHS
      if [[ -n "${ASIMOV_TEST_TMUTIL_FAIL_PATHS:-}" && -f "${ASIMOV_TEST_TMUTIL_FAIL_PATHS}" ]]; then
        if grep -Fxq "$path" "$ASIMOV_TEST_TMUTIL_FAIL_PATHS" 2>/dev/null; then
          # Mirror real tmutil: the POSIXError dump goes to STDOUT (not stderr),
          # while the "Error (-NN)" line goes to stderr. Keeping both faithful is
          # what lets tests catch the dump leaking into Asimov's output.
          echo 'POSIXError(_nsError: Error Domain=NSPOSIXErrorDomain Code=22 "Invalid argument")'
          echo "${path}: Error (-50) while attempting to change exclusion setting." >&2
          exit 22
        fi
      fi
      # Idempotent: don't add if already present (matches real tmutil)
      if ! grep -Fxq "$path" "$ASIMOV_TEST_EXCLUSIONS" 2>/dev/null; then
        printf '%s\n' "$path" >> "$ASIMOV_TEST_EXCLUSIONS"
      fi
    done
    ;;
  *)
    echo "Unknown subcommand: $subcommand" >&2
    exit 1
    ;;
esac
